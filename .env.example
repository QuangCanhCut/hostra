# ==============================================================================
# HOSTRA AI — Biến môi trường mẫu (KHÔNG điền khóa bí mật thật vào file này)
# Sao chép thành `.env` (hoặc `apps/web/.env.local`) khi cần ghi đè cục bộ.
# ==============================================================================

# --- 1. Frontend Mock MVP (apps/web/) ---
# Bật mặc định thanh công cụ chuyển vai trò/kịch bản mô phỏng (DevScenarioBar).
# Mặc định false để giữ giao diện sạch; có thể bật nhanh bằng ?devTools=1 hoặc Ctrl+Shift+D.
VITE_ENABLE_MOCK_SWITCHER=false

# Tùy chọn: Origin công khai dùng để sinh liên kết mời & mã QR cho khách xem trên điện thoại (LAN/staging).
# Để trống để tự động dùng window.location.origin (ví dụ http://localhost:5173).
# VITE_PUBLIC_APP_URL=http://192.168.1.100:5173

# Kênh trình duyệt cho Playwright E2E trên Windows (mặc định tự chọn `chrome` trên Windows).
# PW_CHANNEL=chrome

# --- 2. AI PoC P05 — Knowledge Verification (experiments/sales-intelligence/knowledge-verification/) ---
# Dùng cho thí nghiệm E02 (PostgreSQL + pgvector qua docker-compose.yml trong e02_retrieval/).
P05_PG_DSN=postgresql://postgres:postgres@localhost:5432/hostra_p05

# --- 3. Backend API & Tích hợp Tương lai (CHƯA kích hoạt trong giai đoạn Frontend Mock MVP) ---
# API_BASE_URL=http://localhost:8000
# DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/hostra
# REDIS_URL=redis://localhost:6379/0
# LIVEKIT_URL=wss://your-livekit-instance.example.com
# LIVEKIT_API_KEY=replace_with_dev_key
# LIVEKIT_API_SECRET=replace_with_dev_secret
# OIDC_ISSUER_URL=https://auth.example.com
# OIDC_CLIENT_ID=replace_with_client_id
