# ==============================================================================
# HOSTRA AI — Biến môi trường mẫu cho PoC P06 (Autonomous Storytelling)
# ==============================================================================
# CẢNH BÁO BẢO MẬT & QUYỀN RIÊNG TƯ DỮ LIỆU:
# - KHÔNG BAO GIỜ commit tệp `.env` hoặc API key thật lên Git.
# - Chỉ sử dụng dữ liệu tổng hợp (`SYNTHETIC`) hoặc dữ liệu công khai đã được phê
#   duyệt (`PUBLIC_APPROVED`) khi thử nghiệm với external LLM API.
# - KHÔNG BAO GIỜ gửi dữ liệu riêng tư của merchant, hồ sơ OCOP thật chưa phê
#   duyệt, hoặc dữ liệu viewer thật lên Gemini/external API khi chưa hoàn tất
#   rà soát DPA/terms (`P06-OPEN-1`).
# - Sao chép tệp này thành `.env` cục bộ khi cần ghi đè cấu hình thử nghiệm.
# ==============================================================================

# --- Cấu hình Provider 3 tầng (unit_test: mock | local_smoke_test: ollama | formal_experiment: gemini) ---
P06_MODEL_CONFIG=configs/models/mock.yaml
P06_LLM_PROVIDER=mock

# --- Tầng 2: Local Ollama CPU Smoke Test (không suy diễn latency production) ---
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_ID=qwen3:1.7b

# --- Tầng 3: Formal Experiment (Gemini Flash / Flash-Lite — `TO VALIDATE`) ---
# GEMINI_API_KEY=replace_with_local_dev_key
# P06_GEMINI_MODEL_ID=TBD_VERIFY_QUOTA_PRICING_PRIVACY

# --- Tham số tái lập & đường dẫn dữ liệu ---
P06_RANDOM_SEED=42
P06_RUNS_DIR=runs
P06_P05_SEED_PATH=../knowledge-verification/data/catalog_seed.json
